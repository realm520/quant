"""XT WebSocket user data stream service.

Handles XT WebSocket connections for real-time account updates, position updates,
order updates, and trade updates with automatic reconnection and data synchronization.
"""

import asyncio
import json
import logging
import uuid
import threading
from datetime import datetime, timedelta
from decimal import Decimal
from typing import Any, Dict, Optional, Set

import websockets
from websockets.exceptions import ConnectionClosed, WebSocketException


class DecimalEncoder(json.JSONEncoder):
    """自定义JSON编码器，处理Decimal类型"""
    def default(self, obj):
        if isinstance(obj, Decimal):
            return float(obj)
        return super(DecimalEncoder, self).default(obj)

from tri_arb.storage.database import DatabaseManager
from tri_arb.storage.xt_websocket_models import (
    XTAccountUpdate,
    XTOrderUpdate,
    XTPositionUpdate,
    XTTradeUpdate,
    XTWebSocketConnection,
)

try:
    import pyxt
    from pyxt.websocket.perp import PerpWebsocketStreamClient
    PYXT_AVAILABLE = True
except ImportError:
    PYXT_AVAILABLE = False
    pyxt = None
    PerpWebsocketStreamClient = None

logger = logging.getLogger(__name__)


class XTUserStreamService:
    """XT WebSocket用户数据流服务.
    
    处理XT WebSocket连接，提供实时账户、持仓、订单和成交更新，
    支持自动重连和数据同步机制。
    """
    
    def __init__(
        self,
        api_key: str,
        api_secret: str,
        db_manager: DatabaseManager,
        auto_reconnect: bool = True,
        display_format: str = "table",
        enabled_channels: Optional[Set[str]] = None,
        enable_data_sync: bool = True,
    ):
        """初始化XT WebSocket服务.
        
        Args:
            api_key: XT API密钥
            api_secret: XT API密钥
            db_manager: 数据库管理器
            auto_reconnect: 是否自动重连
            display_format: 显示格式 (table, json)
            enabled_channels: 启用的频道 (account, position, order, trade)
            enable_data_sync: 是否启用数据同步（默认True，防止数据丢失）
        """
        self.api_key = api_key
        self.api_secret = api_secret
        self.db_manager = db_manager
        self.auto_reconnect = auto_reconnect
        self.display_format = display_format
        self.enable_data_sync = enable_data_sync

        # 默认启用所有频道（包括成交记录）
        self.enabled_channels = enabled_channels or {"account", "position", "order", "trade"}
        
        # WebSocket连接状态
        self.websocket = None
        self.connection_id = None
        self.is_connected = False
        self.is_running = False
        
        # 重连配置
        self.reconnect_delay = 5  # 重连延迟（秒）
        self.max_reconnect_attempts = 10
        self.reconnect_attempts = 0

        # 断线时间记录（用于补充断线期间的数据）
        self.disconnect_time = None
        self.reconnect_time = None

        # XT REST API客户端（用于获取listen_key和数据同步）
        # 优先使用 pyxt，如果不可用则抛出错误
        if not PYXT_AVAILABLE:
            raise RuntimeError("pyxt package is required but not installed. Please install it with: pip install pyxt")

        # 初始化 pyxt REST 客户端
        self.pyxt_client = None
        self._init_pyxt_client()

        # 初始化 pyxt WebSocket 客户端
        self.ws_client = None

        # XT WebSocket认证
        self.listen_key = None

        # 数据缓存（用于检测变化）
        self._last_account_data = {}
        self._last_position_data = {}
        self._last_order_data = {}
        self._last_trade_data = {}
        
        logger.debug("XT WebSocket service initialized",
                    extra={
                        "enabled_channels": list(self.enabled_channels),
                        "data_sync_enabled": self.enable_data_sync,
                        "fixed_lookback_hours": 1,
                        "using_pyxt": PYXT_AVAILABLE
                    })

    def _init_pyxt_client(self) -> None:
        """初始化 pyxt 客户端."""
        # XT API 主机地址
        host = "https://sapi.xt.com"

        try:
            # 尝试从 pyxt.perp 导入 Perp 类
            from pyxt.perp import Perp
            self.pyxt_client = Perp(host, self.api_key, self.api_secret)
            logger.info("Initialized pyxt.perp.Perp client")
            return
        except ImportError:
            logger.error("Failed to import pyxt.perp.Perp")
        except Exception as e:
            logger.error(f"Failed to initialize pyxt.perp.Perp: {e}")

        # 如果上述方法失败，尝试其他可能的客户端类
        candidates = [
            ("spot", "Spot"),
        ]

        for module_name, class_name in candidates:
            try:
                module = __import__(f"pyxt.{module_name}", fromlist=[class_name])
                if hasattr(module, class_name):
                    cls = getattr(module, class_name)
                    self.pyxt_client = cls(host, self.api_key, self.api_secret)
                    logger.info(f"Initialized pyxt.{module_name}.{class_name} client")
                    return
            except Exception as e:
                logger.debug(f"Failed to initialize pyxt.{module_name}.{class_name}: {e}")
                continue

        raise RuntimeError("Failed to initialize any pyxt client class")
    
    async def start(self) -> None:
        """启动WebSocket服务."""
        if self.is_running:
            logger.warning("XT WebSocket service is already running")
            return

        self.is_running = True
        self.connection_id = str(uuid.uuid4())

        logger.debug("pyxt client ready")

        # 记录连接开始
        await self._record_connection_start()

        logger.debug("Starting XT WebSocket service")
        
        # 启动WebSocket连接循环
        while self.is_running:
            try:
                await self._connect_and_listen()
            except Exception as e:
                logger.error(f"WebSocket connection error: {e}")
                
                if self.auto_reconnect and self.reconnect_attempts < self.max_reconnect_attempts:
                    self.reconnect_attempts += 1
                    logger.info(
                        f"Attempting to reconnect ({self.reconnect_attempts}/{self.max_reconnect_attempts})",
                        delay=self.reconnect_delay,
                    )
                    await asyncio.sleep(self.reconnect_delay)
                else:
                    logger.error("Max reconnection attempts reached, stopping service")
                    break
        
        # 记录连接结束
        await self._record_connection_end()

        logger.info("XT WebSocket service stopped")
    
    async def stop(self) -> None:
        """停止WebSocket服务."""
        logger.info("Stopping XT WebSocket service")
        self.is_running = False
        
        if self.websocket:
            await self.websocket.close()
            self.websocket = None
        
        self.is_connected = False
    
    async def _connect_and_listen(self) -> None:
        """使用 pyxt WebSocket 客户端建立连接并监听消息."""
        try:
            logger.debug("Initializing pyxt WebSocket client")

            # 创建消息队列用于线程间通信
            self.message_queue = asyncio.Queue()

            # 获取事件循环供回调使用
            loop = asyncio.get_event_loop()

            # 创建 pyxt WebSocket 客户端（在单独的线程中运行）
            def on_message(ws_app, message):
                """WebSocket 消息回调."""
                try:
                    # 将消息放入队列
                    asyncio.run_coroutine_threadsafe(
                        self.message_queue.put(message),
                        loop
                    )
                except Exception as e:
                    logger.error(f"Error queueing message: {e}")

            def on_open(ws_app):
                """WebSocket 连接打开回调."""
                self.is_connected = True
                self.reconnect_attempts = 0
                logger.info("pyxt WebSocket connected")

                # 记录重连时间
                if self.disconnect_time:
                    self.reconnect_time = datetime.utcnow()
                    logger.info("Reconnected", extra={"reconnect_time": self.reconnect_time.isoformat()})

                    # 补充断线期间缺失的数据（使用固定1小时回补）
                    if self.enable_data_sync:
                        asyncio.run_coroutine_threadsafe(
                            self._sync_missing_data(),
                            loop
                        )

            def on_close(ws_app, close_status_code, close_msg):
                """WebSocket 连接关闭回调."""
                self.is_connected = False
                self.disconnect_time = datetime.utcnow()
                logger.warning(f"pyxt WebSocket closed: {close_status_code} - {close_msg}")

            def on_error(ws_app, error):
                """WebSocket 错误回调."""
                logger.error(f"pyxt WebSocket error: {error}")
                self.is_connected = False

            # 创建 pyxt WebSocket 客户端
            # pyxt 会自动处理认证和获取 listen_key
            self.ws_client = PerpWebsocketStreamClient(
                stream_url="wss://fstream.xt.com",
                on_message=on_message,
                on_open=on_open,
                on_close=on_close,
                on_error=on_error,
                is_auth=True  # 使用认证WebSocket
            )

            # 在单独的线程中启动WebSocket客户端并订阅
            def run_ws_client():
                try:
                    logger.debug("Starting pyxt WebSocket client in thread")

                    # 首先需要获取 listen_key 并订阅
                    # 使用 pyxt REST 客户端获取 listen_key
                    listen_key_result = self.pyxt_client.get_listen_key()

                    # 解析 listen_key
                    listen_key = None
                    if isinstance(listen_key_result, tuple) and len(listen_key_result) >= 2:
                        code, success, error = listen_key_result
                        if code == 200 and success:
                            if isinstance(success, dict):
                                listen_key = success.get("listenKey") or success.get("result", {}).get("listenKey")
                            elif isinstance(success, str):
                                listen_key = success

                    if not listen_key:
                        logger.error(f"Failed to get listen key: {listen_key_result}")
                        return

                    logger.info(f"Obtained listen key for WebSocket subscription")
                    self.listen_key = listen_key

                    # 订阅用户数据流
                    if "account" in self.enabled_channels:
                        self.ws_client.user_balance(listen_key, action="sub")
                        logger.info("Subscribed to account/balance channel")

                    if "position" in self.enabled_channels:
                        self.ws_client.user_position(listen_key, action="sub")
                        logger.info("Subscribed to position channel")

                    if "order" in self.enabled_channels:
                        self.ws_client.user_order(listen_key, action="sub")
                        logger.info("Subscribed to order channel")

                    if "trade" in self.enabled_channels:
                        self.ws_client.user_trade(listen_key, action="sub")
                        logger.info("Subscribed to trade channel")

                    # 启动 pyxt WebSocket 客户端（阻塞调用）
                    self.ws_client.run()
                except Exception as e:
                    logger.error(f"Error in WebSocket thread: {e}")
                    import traceback
                    logger.error(traceback.format_exc())

            ws_thread = threading.Thread(target=run_ws_client, daemon=True)
            ws_thread.start()

            # 处理消息队列
            while self.is_running:
                try:
                    # 从队列中获取消息
                    message = await asyncio.wait_for(self.message_queue.get(), timeout=1.0)
                    await self._handle_message(message)
                except asyncio.TimeoutError:
                    # 超时是正常的，继续等待
                    continue
                except Exception as e:
                    logger.error(f"Error processing message: {e}")

        except Exception as e:
            logger.error(f"WebSocket connection error: {e}")
            self.is_connected = False
            self.disconnect_time = datetime.utcnow()


    async def _handle_message(self, message: str) -> None:
        """处理WebSocket消息."""
        try:
            # 检查消息是否为空或只包含空白字符
            if not message or not message.strip():
                logger.debug("Received empty WebSocket message")
                return
            
            data = json.loads(message)
            
            # 更新消息统计
            await self._update_message_stats()

            # XT WebSocket消息格式处理
            # 检查是否是订阅确认消息
            if "result" in data and data.get("id") == 1:
                logger.info("Subscription confirmed", extra={"result": data.get("result")})
                return

            # 检查是否是错误消息
            if "error" in data:
                error_code = data.get("error", {}).get("code") if isinstance(data.get("error"), dict) else data.get("error")
                error_msg = data.get("error", {}).get("message", "") if isinstance(data.get("error"), dict) else str(data.get("error"))

                if "invalid_listen_key" in str(error_code) or "invalid_listen_key" in str(error_msg):
                    logger.error("Listen key expired or invalid, need to reconnect", extra={"error": error_msg})
                    # listen_key过期，需要重新连接
                    self.is_connected = False
                    return
                else:
                    logger.error("WebSocket error", extra={"error_code": error_code, "error_msg": error_msg})
                    return

            # 处理数据推送消息
            stream = data.get("stream", "")
            if "@" in stream:
                channel = stream.split("@")[0]
                listen_key = stream.split("@")[1]
                
                logger.info("Received WebSocket message", extra={"channel": channel, "stream": stream})
                
                # 根据频道类型处理数据
                if channel == "balance" and "account" in self.enabled_channels:
                    await self._handle_account_update(data)
                elif channel == "position" and "position" in self.enabled_channels:
                    await self._handle_position_update(data)
                elif channel == "order" and "order" in self.enabled_channels:
                    await self._handle_order_update(data)
                elif channel == "trade" and "trade" in self.enabled_channels:
                    await self._handle_trade_update(data)
                else:
                    logger.debug("Unknown channel or channel disabled", extra={"channel": channel})
            else:
                logger.debug("Unknown message format", extra={"data_sample": str(data)[:200]})
                
        except json.JSONDecodeError as e:
            logger.debug(f"Failed to parse WebSocket message: {e}")
            # 记录原始消息内容以便调试
            logger.debug(f"Raw message content: {repr(message[:200])}")
        except Exception as e:
            logger.error(f"Error handling WebSocket message: {e}")
    
    async def _handle_account_update(self, data: Dict[str, Any]) -> None:
        """处理账户更新消息."""
        if "account" not in self.enabled_channels:
            return
        
        # 提取XT账户数据
        account_data = data.get("data", {})
        logger.debug("Account update data", extra={"account_data": account_data})
        if not account_data:
            logger.warning("No account data in message")
            return
        
        # 检查数据是否有变化
        if not self._has_account_changed(account_data):
            return
        
        try:
            # 显示账户更新
            await self._display_account_update(account_data)
            
            # 保存到数据库
            await self._save_account_update(account_data)
            
            # 更新统计
            await self._update_account_stats()
            
        except Exception as e:
            logger.error(f"Error handling account update: {e}")
    
