    async def _save_account_update(self, data: Dict[str, Any]) -> None:
        """保存账户更新到数据库."""
        try:
            async with self.db_manager.session() as session:
                balances = data.get("balances", [])
                update_time = datetime.utcnow()
                
                for balance in balances:
                    currency = balance.get("currency", "")
                    if not currency:
                        continue
                    
                    available = self._safe_decimal(balance.get("available", "0"))
                    frozen = self._safe_decimal(balance.get("frozen", "0"))
                    total = available + frozen
                    
                    record = XTAccountUpdate(
                        update_time=update_time,
                        currency=currency,
                        available=available,
                        frozen=frozen,
                        total=total,
                        raw_data=json.dumps(balance, cls=DecimalEncoder),
                    )
                    session.add(record)
                
                await session.commit()
                logger.debug("Saved account update to database")
                
        except Exception as e:
            logger.error(f"Failed to save account update: {e}")
    
    async def _save_position_update(self, data: Dict[str, Any]) -> None:
        """保存持仓更新到数据库."""
        try:
            async with self.db_manager.session() as session:
                positions = data.get("positions", [])
                update_time = datetime.utcnow()
                
                for position in positions:
                    symbol = position.get("symbol", "")
                    if not symbol:
                        continue
                    
                    side = position.get("side", "")
                    quantity = self._safe_decimal(position.get("quantity", "0"))
                    
                    # 跳过持仓量为0的记录
                    if quantity == 0:
                        continue
                    
                    record = XTPositionUpdate(
                        update_time=update_time,
                        symbol=symbol,
                        side=side,
                        quantity=quantity,
                        entry_price=self._safe_decimal(position.get("entry_price", "0")),
                        mark_price=self._safe_decimal(position.get("mark_price", "0")),
                        liquidation_price=self._safe_decimal(position.get("liquidation_price", "0")),
                        unrealized_pnl=self._safe_decimal(position.get("unrealized_pnl", "0")),
                        leverage=self._safe_int(position.get("leverage", "1")),
                        margin=self._safe_decimal(position.get("margin", "0")),
                        roe=self._safe_decimal(position.get("roe", "0")),
                        raw_data=json.dumps(position, cls=DecimalEncoder),
                    )
                    session.add(record)
                
                await session.commit()
                logger.debug("Saved position update to database")
                
        except Exception as e:
            logger.error(f"Failed to save position update: {e}")
    
    async def _save_order_update(self, data: Dict[str, Any]) -> None:
        """保存订单更新到数据库."""
        try:
            async with self.db_manager.session() as session:
                orders = data.get("orders", [])
                update_time = datetime.utcnow()
                
                for order in orders:
                    order_id = order.get("order_id", "")
                    if not order_id:
                        continue
                    
                    symbol = order.get("symbol", "")
                    side = order.get("side", "")
                    order_type = order.get("order_type", "")
                    quantity = self._safe_decimal(order.get("quantity", "0"))
                    price = self._safe_decimal(order.get("price", "0"))
                    filled_quantity = self._safe_decimal(order.get("filled_quantity", "0"))
                    status = order.get("status", "")
                    
                    record = XTOrderUpdate(
                        update_time=update_time,
                        symbol=symbol,
                        order_id=order_id,
                        client_order_id=order.get("client_order_id", ""),
                        side=side,
                        order_type=order_type,
                        position_side=order.get("position_side", ""),
                        quantity=quantity,
                        price=price,
                        filled_quantity=filled_quantity,
                        status=status,
                        time_in_force=order.get("time_in_force", ""),
                        create_time=self._parse_timestamp(order.get("create_time")),
                        update_time_order=self._parse_timestamp(order.get("update_time")),
                        raw_data=json.dumps(order, cls=DecimalEncoder),
                    )
                    session.add(record)
                
                await session.commit()
                logger.debug("Saved order update to database")
                
        except Exception as e:
            logger.error(f"Failed to save order update: {e}")
    
    async def _save_trade_update(self, data: Dict[str, Any]) -> None:
        """保存成交更新到数据库."""
        try:
            async with self.db_manager.session() as session:
                trades = data.get("trades", [])
                update_time = datetime.utcnow()
                
                for trade in trades:
                    trade_id = trade.get("trade_id", "")
                    if not trade_id:
                        continue
                    
                    order_id = trade.get("order_id", "")
                    symbol = trade.get("symbol", "")
                    side = trade.get("side", "")
                    price = self._safe_decimal(trade.get("price", "0"))
                    quantity = self._safe_decimal(trade.get("quantity", "0"))
                    quote_quantity = price * quantity
                    
                    record = XTTradeUpdate(
                        update_time=update_time,
                        symbol=symbol,
                        order_id=order_id,
                        trade_id=trade_id,
                        side=side,
                        price=price,
                        quantity=quantity,
                        quote_quantity=quote_quantity,
                        commission=self._safe_decimal(trade.get("commission", "0")),
                        commission_asset=trade.get("commission_asset", ""),
                        is_maker=trade.get("is_maker", False),
                        position_side=trade.get("position_side", ""),
                        raw_data=json.dumps(trade, cls=DecimalEncoder),
                    )
                    session.add(record)
                
                await session.commit()
                logger.debug("Saved trade update to database")
                
        except Exception as e:
            logger.error(f"Failed to save trade update: {e}")
    
    async def _sync_missing_data(self) -> None:
        """补充断线期间缺失的数据.

        仅在重连后调用，固定回补1小时内的订单和成交数据。
        账户和持仓数据直接获取最新状态。
        """
        if not self.enable_data_sync or not self.pyxt_client:
            logger.debug("Data sync is disabled or pyxt client not available")
            return

        try:
            # 固定回补时间为1小时
            lookback_hours = 1
            end_time = datetime.utcnow()
            start_time = end_time - timedelta(hours=lookback_hours)

            logger.debug(
                "Syncing missing data for fixed 1-hour lookback period",
                extra={
                    "lookback_hours": lookback_hours,
                    "start_time": start_time.isoformat(),
                    "end_time": end_time.isoformat()
                }
            )

            # 同步账户余额（总是同步最新状态）
            if "account" in self.enabled_channels:
                await self._sync_account_data()

            # 同步持仓数据（总是同步最新状态）
            if "position" in self.enabled_channels:
                await self._sync_position_data()

            # 同步订单数据（固定1小时回补）
            if "order" in self.enabled_channels:
                await self._sync_order_data_fixed_lookback(start_time, end_time)

            # 同步成交数据（固定1小时回补）
            if "trade" in self.enabled_channels:
                await self._sync_trade_data_fixed_lookback(start_time, end_time)

            # 清除断线时间记录
            if self.disconnect_time:
                logger.debug("Clearing disconnect time after sync")
                self.disconnect_time = None

            # 更新同步统计（记录重连补充数据的次数）
            await self._update_sync_stats()

            logger.info("Missing data sync completed successfully")

        except Exception as e:
            logger.error(f"Failed to sync missing data: {e}")
    
    async def _sync_account_data(self) -> None:
        """使用 pyxt 同步账户数据."""
        try:
            # 调用 pyxt 的 get_account_capital 方法
            result = self.pyxt_client.get_account_capital()

            if not result:
                logger.warning("No account capital data from pyxt client")
                return

            # 解析响应数据
            # XT API 通常返回 {"returnCode": 0, "result": {...}}
            if isinstance(result, dict):
                # 如果有 result 字段，提取它
                if "result" in result:
                    result = result["result"]

                # 解析余额数据
                balances_data = {}

                # 可能的字段结构
                if "assets" in result:
                    # assets 字段包含余额列表
                    for asset in result["assets"]:
                        currency = asset.get("currency") or asset.get("asset")
                        if currency:
                            balances_data[currency] = {
                                "available": asset.get("available", 0) or asset.get("availableBalance", 0),
                                "frozen": asset.get("frozen", 0) or asset.get("frozenBalance", 0),
                            }
                elif "balances" in result:
                    # balances 字段
                    for balance in result["balances"]:
                        currency = balance.get("currency") or balance.get("asset")
                        if currency:
                            balances_data[currency] = {
                                "available": balance.get("available", 0),
                                "frozen": balance.get("frozen", 0),
                            }
                else:
                    # 直接是余额字典
                    for currency, balance_data in result.items():
                        if isinstance(balance_data, dict):
                            balances_data[currency] = balance_data

                if not balances_data:
                    logger.warning(f"Failed to parse balance data from response: {result}")
                    return

                # 保存到数据库
                async with self.db_manager.session() as session:
                    update_time = datetime.utcnow()

                    for currency, balance_data in balances_data.items():
                        available = self._safe_decimal(balance_data.get("available", 0))
                        frozen = self._safe_decimal(balance_data.get("frozen", 0))
                        total = available + frozen

                        record = XTAccountUpdate(
                            update_time=update_time,
                            currency=currency,
                            available=available,
                            frozen=frozen,
                            total=total,
                            raw_data=json.dumps({
                                "source": "pyxt_sync",
                                "currency": currency,
                                "balance_data": {
                                    "available": str(available),
                                    "frozen": str(frozen),
                                    "total": str(total),
                                },
                            }, cls=DecimalEncoder),
                        )
                        session.add(record)

                    await session.commit()
                    logger.debug("Synced account data from pyxt")

        except Exception as e:
            logger.error(f"Failed to sync account data: {e}")
    
    async def _sync_position_data(self) -> None:
        """使用 pyxt 同步持仓数据."""
        try:
            # 调用 pyxt 的 get_position 方法，传 None 获取所有持仓
            result = self.pyxt_client.get_position(symbol=None)

            if not result:
                logger.debug("No position data from pyxt client")
                return

            # 解析响应数据
            if isinstance(result, dict):
                # 如果有 result 字段，提取它
                if "result" in result:
                    result = result["result"]

            # 确保是列表格式
            positions_data = result
            if isinstance(result, dict):
                # 如果是字典，可能包含 positions 字段
                if "positions" in result:
                    positions_data = result["positions"]
                else:
                    # 单个持仓
                    positions_data = [result]
            elif not isinstance(result, list):
                positions_data = [result]

            # 保存到数据库
            async with self.db_manager.session() as session:
                update_time = datetime.utcnow()

                for position in positions_data:
                    if not isinstance(position, dict):
                        continue

                    symbol = position.get("symbol", "")
                    if not symbol:
                        continue

                    # 解析持仓方向和数量
                    quantity = self._safe_decimal(position.get("positionSize", 0) or position.get("quantity", 0))

                    # 跳过持仓量为0的记录
                    if quantity == 0:
                        continue

                    # 根据持仓方向判断
                    side = position.get("positionSide", "") or position.get("side", "")
                    if not side:
                        # 如果没有明确的方向，根据数量判断
                        side = "LONG" if quantity > 0 else "SHORT"
                        quantity = abs(quantity)

                    entry_price = self._safe_decimal(position.get("avgPrice", 0) or position.get("entry_price", 0) or position.get("entryPrice", 0))
                    mark_price = self._safe_decimal(position.get("markPrice", 0) or position.get("mark_price", 0))
                    liquidation_price = self._safe_decimal(position.get("liquidatePrice", 0) or position.get("liquidation_price", 0) or position.get("liquidationPrice", 0))
                    unrealized_pnl = self._safe_decimal(position.get("unrealizedProfit", 0) or position.get("unrealized_pnl", 0) or position.get("unrealizedPnl", 0))
                    leverage = self._safe_int(position.get("leverage", 1))
                    margin = self._safe_decimal(position.get("margin", 0) or position.get("positionMargin", 0))
                    roe = self._safe_decimal(position.get("roe", 0))

                    record = XTPositionUpdate(
                        update_time=update_time,
                        symbol=symbol,
                        side=side,
                        quantity=quantity,
                        entry_price=entry_price,
                        mark_price=mark_price,
                        liquidation_price=liquidation_price,
                        unrealized_pnl=unrealized_pnl,
                        leverage=leverage,
                        margin=margin,
                        roe=roe,
                        raw_data=json.dumps({
                            "source": "pyxt_sync",
                            "position": position,
                        }, cls=DecimalEncoder),
                    )
                    session.add(record)

                await session.commit()
                logger.debug("Synced position data from pyxt")

        except Exception as e:
            logger.error(f"Failed to sync position data: {e}")
    
    async def _sync_order_data(self, use_disconnect_period: bool = False) -> None:
        """使用 pyxt 同步订单数据.

        Args:
            use_disconnect_period: 是否使用断线时间区间查询
        """
        try:
            # 构建查询参数
            kwargs = {'symbol': None, 'limit': 500}

            if use_disconnect_period and self.disconnect_time and self.reconnect_time:
                kwargs['start_time'] = int(self.disconnect_time.timestamp() * 1000)
                kwargs['end_time'] = int(self.reconnect_time.timestamp() * 1000)
                logger.info(
                    "Syncing orders for disconnection period",
                    extra={
                        "start_time": self.disconnect_time.isoformat(),
                        "end_time": self.reconnect_time.isoformat()
                    }
                )
            else:
                logger.info("Syncing recent orders")

            # 调用 pyxt 的 get_history_order 方法
            result = self.pyxt_client.get_history_order(**kwargs)

            if not result:
                logger.debug("No order data from pyxt client")
                return

            # 解析响应数据
            if isinstance(result, dict):
                if "result" in result:
                    result = result["result"]

            # 确保是列表格式
            orders_data = result
            if isinstance(result, dict):
                if "items" in result:
                    orders_data = result["items"]
                elif "orders" in result:
                    orders_data = result["orders"]
                else:
                    orders_data = [result]
            elif not isinstance(result, list):
                orders_data = [result]

            # 保存到数据库
            async with self.db_manager.session() as session:
                from sqlalchemy import select
                update_time = datetime.utcnow()
                saved_count = 0
                skipped_count = 0

                for order in orders_data:
                    if not isinstance(order, dict):
                        continue

                    try:
                        symbol = order.get("symbol", "")
                        order_id = (order.get("orderId") or
                                  order.get("order_id") or
                                  order.get("id") or
                                  order.get("clientOrderId"))

                        if not order_id or not symbol:
                            continue

                        # 检查订单是否已存在（去重）
                        existing_result = await session.execute(
                            select(XTOrderUpdate).where(
                                XTOrderUpdate.order_id == str(order_id),
                                XTOrderUpdate.symbol == symbol
                            ).limit(1)
                        )
                        existing_order = existing_result.scalar_one_or_none()

                        if existing_order:
                            logger.debug(f"Order {order_id} already exists, skipping")
                            skipped_count += 1
                            continue

                        side = order.get("side", "")
                        order_type = order.get("orderType", "") or order.get("type", "")
                        quantity = self._safe_decimal(order.get("origQty", 0) or order.get("quantity", 0) or order.get("qty", 0))
                        price = self._safe_decimal(order.get("price", 0))
                        filled_qty = self._safe_decimal(order.get("executedQty", 0) or order.get("filled_quantity", 0))
                        status = order.get("state", "") or order.get("status", "")
                        create_time = self._parse_timestamp(order.get("createTime") or order.get("time") or order.get("timestamp"))

                        record = XTOrderUpdate(
                            update_time=update_time,
                            symbol=symbol,
                            order_id=str(order_id),
                            client_order_id=str(order.get("clientOrderId", "")),
                            side=side,
                            order_type=order_type,
                            position_side=order.get("positionSide", "LONG"),
                            quantity=quantity,
                            price=price,
                            filled_quantity=filled_qty,
                            status=status,
                            time_in_force=order.get("timeInForce", "GTC"),
                            create_time=create_time,
                            update_time_order=create_time,
                            raw_data=json.dumps({
                                "source": "pyxt_sync",
                                "order_id": str(order_id),
                            }, cls=DecimalEncoder),
                        )
                        session.add(record)
                        saved_count += 1

                    except Exception as e:
                        logger.warning(f"Failed to save order: {e}")
                        continue

                await session.commit()
                logger.debug("Synced order data from pyxt", extra={"saved": saved_count, "skipped": skipped_count})

        except Exception as e:
            logger.error(f"Failed to sync order data: {e}")
    
    async def _sync_trade_data(self, use_disconnect_period: bool = False) -> None:
        """使用 pyxt 同步成交数据.

        Args:
            use_disconnect_period: 是否使用断线时间区间查询
        """
        try:
            # 构建查询参数
            kwargs = {}

            if use_disconnect_period and self.disconnect_time and self.reconnect_time:
                kwargs['start_time'] = int(self.disconnect_time.timestamp() * 1000)
                kwargs['end_time'] = int(self.reconnect_time.timestamp() * 1000)
                logger.info(
                    "Syncing trades for disconnection period",
                    extra={
                        "start_time": self.disconnect_time.isoformat(),
                        "end_time": self.reconnect_time.isoformat(),
                    }
                )
            else:
                logger.info("Syncing recent trades")

            # 尝试多个可能的方法名
            method_names = ["get_user_trades", "get_trades", "trade_list", "query_trades", "my_trades"]

            trades_data = None
            for method_name in method_names:
                if hasattr(self.pyxt_client, method_name):
                    try:
                        method = getattr(self.pyxt_client, method_name)
                        trades_data = method(**kwargs)
                        if trades_data:
                            break
                    except Exception as e:
                        logger.debug(f"Failed to call {method_name}: {e}")
                        continue

            if not trades_data:
                logger.debug("No trade data from pyxt client")
                return

            # 确保是列表格式
            if not isinstance(trades_data, list):
                trades_data = [trades_data]

            # 保存到数据库
            async with self.db_manager.session() as session:
                from sqlalchemy import select
                update_time = datetime.utcnow()
                saved_count = 0
                skipped_count = 0

                for trade in trades_data:
                    try:
                        # 处理不同的数据格式
                        if isinstance(trade, dict):
                            symbol = trade.get("symbol", "")
                            trade_id = trade.get("id") or trade.get("tradeId") or trade.get("trade_id")
                            order_id = trade.get("orderId") or trade.get("order_id")
                            side = trade.get("side", "")
                            price = self._safe_decimal(trade.get("price", 0))
                            quantity = self._safe_decimal(trade.get("qty", 0) or trade.get("quantity", 0))
                            quote_qty = self._safe_decimal(trade.get("quoteQty", 0) or trade.get("quote_quantity", 0))
                            commission = self._safe_decimal(trade.get("commission", 0))
                            commission_asset = trade.get("commissionAsset", "") or trade.get("commission_asset", "")
                            is_maker = trade.get("isMaker", False) or trade.get("is_maker", False)
                            position_side = trade.get("positionSide", "") or trade.get("position_side", "")
                        else:
                            symbol = getattr(trade, "symbol", "")
                            trade_id = getattr(trade, "trade_id", "") or getattr(trade, "id", "")
                            order_id = getattr(trade, "order_id", "")
                            side = getattr(trade, "side", "")
                            price = self._safe_decimal(getattr(trade, "price", 0))
                            quantity = self._safe_decimal(getattr(trade, "quantity", 0))
                            quote_qty = self._safe_decimal(getattr(trade, "quote_quantity", 0))
                            commission = self._safe_decimal(getattr(trade, "commission", 0))
                            commission_asset = getattr(trade, "commission_asset", "")
                            is_maker = getattr(trade, "is_maker", False)
                            position_side = getattr(trade, "position_side", "")

                        if not trade_id:
                            continue

                        # 检查成交是否已存在（去重）
                        existing_result = await session.execute(
                            select(XTTradeUpdate).where(
                                XTTradeUpdate.trade_id == str(trade_id),
                                XTTradeUpdate.symbol == symbol
                            ).limit(1)
                        )
                        existing_trade = existing_result.scalar_one_or_none()

                        if existing_trade:
                            logger.debug(f"Trade {trade_id} already exists, skipping")
                            skipped_count += 1
                            continue

                        record = XTTradeUpdate(
                            update_time=update_time,
                            symbol=symbol,
                            order_id=str(order_id),
                            trade_id=str(trade_id),
                            side=side,
                            price=price,
                            quantity=quantity,
                            quote_quantity=quote_qty,
                            commission=commission,
                            commission_asset=commission_asset,
                            is_maker=is_maker,
                            position_side=position_side,
                            raw_data=json.dumps({
                                "source": "pyxt_sync",
                                "trade": str(trade),
                            }, cls=DecimalEncoder),
                        )
                        session.add(record)
                        saved_count += 1

                    except Exception as e:
                        logger.warning(f"Failed to save trade: {e}")
                        continue

                await session.commit()
                logger.debug("Synced trade data from pyxt", extra={"saved": saved_count, "skipped": skipped_count})

        except Exception as e:
            logger.error(f"Failed to sync trade data: {e}")
    
    async def _sync_order_data_fixed_lookback(self, start_time: datetime, end_time: datetime) -> None:
        """使用 pyxt 同步订单数据（固定回补时间）.

        Args:
            start_time: 开始时间
            end_time: 结束时间
        """
        try:
            # 转换为毫秒时间戳
            start_timestamp = int(start_time.timestamp() * 1000)
            end_timestamp = int(end_time.timestamp() * 1000)

            logger.info(
                "Syncing orders for fixed lookback period",
                extra={
                    "start_time": start_time.isoformat(),
                    "end_time": end_time.isoformat(),
                    "start_timestamp": start_timestamp,
                    "end_timestamp": end_timestamp
                }
            )

            # 尝试多个可能的方法名
            method_names = ["get_order_list", "get_orders", "order_list", "query_orders"]

            orders_data = None
            for method_name in method_names:
                if hasattr(self.pyxt_client, method_name):
                    try:
                        method = getattr(self.pyxt_client, method_name)
                        orders_data = method(
                            start_time=start_timestamp,
                            end_time=end_timestamp,
                            limit=1000
                        )
                        if orders_data:
                            break
                    except Exception as e:
                        logger.debug(f"Failed to call {method_name}: {e}")
                        continue

            if not orders_data:
                logger.debug("No order data from pyxt client")
                return

            # 确保是列表格式
            if not isinstance(orders_data, list):
                orders_data = [orders_data]

            # 保存到数据库
            async with self.db_manager.session() as session:
                from sqlalchemy import select
                update_time = datetime.utcnow()
                saved_count = 0
                skipped_count = 0

                for order in orders_data:
                    try:
                        # 处理不同的数据格式
                        if isinstance(order, dict):
                            symbol = order.get("symbol", "")
                            order_id = order.get("orderId") or order.get("order_id") or order.get("id")
                            side = order.get("side", "")
                            order_type = order.get("type") or order.get("order_type", "")
                            quantity = self._safe_decimal(order.get("quantity", 0) or order.get("qty", 0))
                            price = self._safe_decimal(order.get("price", 0))
                            filled_qty = self._safe_decimal(order.get("executedQty", 0) or order.get("filled_quantity", 0))
                            status = order.get("status", "")
                            create_time = self._parse_timestamp(order.get("time") or order.get("createTime"))
                        else:
                            symbol = getattr(order, "symbol", "")
                            order_id = getattr(order, "exchange_order_id", "") or getattr(order, "order_id", "")
                            side = getattr(order, "side", "")
                            if hasattr(side, "value"):
                                side = side.value
                            order_type = getattr(order, "order_type", "")
                            if hasattr(order_type, "value"):
                                order_type = order_type.value
                            quantity = self._safe_decimal(getattr(order, "quantity", 0))
                            price = self._safe_decimal(getattr(order, "price", 0))
                            filled_qty = self._safe_decimal(getattr(order, "filled_quantity", 0))
                            status = getattr(order, "status", "")
                            if hasattr(status, "value"):
                                status = status.value
                            create_time = getattr(order, "timestamp", None)

                        if not order_id or not symbol:
                            continue

                        # 检查订单是否已存在（去重）
                        existing_result = await session.execute(
                            select(XTOrderUpdate).where(
                                XTOrderUpdate.order_id == str(order_id),
                                XTOrderUpdate.symbol == symbol
                            ).limit(1)
                        )
                        existing_order = existing_result.scalar_one_or_none()

                        if existing_order:
                            logger.debug(f"Order {order_id} already exists, skipping")
                            skipped_count += 1
                            continue

                        record = XTOrderUpdate(
                            update_time=update_time,
                            symbol=symbol,
                            order_id=str(order_id),
                            client_order_id="",
                            side=side,
                            order_type=order_type,
                            position_side="LONG",
                            quantity=quantity,
                            price=price,
                            filled_quantity=filled_qty,
                            status=status,
                            time_in_force="GTC",
                            create_time=create_time,
                            update_time_order=create_time,
                            raw_data=json.dumps({
                                "source": "pyxt_sync_fixed_lookback",
                                "order_id": str(order_id),
                                "lookback_hours": 1,
                            }, cls=DecimalEncoder),
                        )
                        session.add(record)
                        saved_count += 1

                    except Exception as e:
                        logger.warning(f"Failed to save order: {e}")
                        continue

                await session.commit()
                logger.info("Synced order data from pyxt (fixed lookback)", extra={"saved": saved_count, "skipped": skipped_count})

        except Exception as e:
            logger.error(f"Failed to sync order data (fixed lookback): {e}")
    
    async def _sync_trade_data_fixed_lookback(self, start_time: datetime, end_time: datetime) -> None:
        """使用 pyxt 同步成交数据（固定回补时间）.

        Args:
            start_time: 开始时间
            end_time: 结束时间
        """
        try:
            # 转换为毫秒时间戳
            start_timestamp = int(start_time.timestamp() * 1000)
            end_timestamp = int(end_time.timestamp() * 1000)

            logger.info(
                "Syncing trades for fixed lookback period",
                extra={
                    "start_time": start_time.isoformat(),
                    "end_time": end_time.isoformat(),
                    "start_timestamp": start_timestamp,
                    "end_timestamp": end_timestamp
                }
            )

            # 尝试多个可能的方法名
            method_names = ["get_user_trades", "get_trades", "trade_list", "query_trades", "my_trades"]

            trades_data = None
            for method_name in method_names:
                if hasattr(self.pyxt_client, method_name):
                    try:
                        method = getattr(self.pyxt_client, method_name)
                        trades_data = method(
                            start_time=start_timestamp,
                            end_time=end_timestamp,
                            limit=1000
                        )
                        if trades_data:
                            break
                    except Exception as e:
                        logger.debug(f"Failed to call {method_name}: {e}")
                        continue

            if not trades_data:
                logger.debug("No trade data from pyxt client")
                return

            # 确保是列表格式
            if not isinstance(trades_data, list):
                trades_data = [trades_data]

            # 保存到数据库
            async with self.db_manager.session() as session:
                from sqlalchemy import select
                update_time = datetime.utcnow()
                saved_count = 0
                skipped_count = 0

                for trade in trades_data:
                    try:
                        # 处理不同的数据格式
                        if isinstance(trade, dict):
                            symbol = trade.get("symbol", "")
                            trade_id = trade.get("id") or trade.get("tradeId") or trade.get("trade_id")
                            order_id = trade.get("orderId") or trade.get("order_id")
                            side = trade.get("side", "")
                            price = self._safe_decimal(trade.get("price", 0))
                            quantity = self._safe_decimal(trade.get("qty", 0) or trade.get("quantity", 0))
                            quote_qty = self._safe_decimal(trade.get("quoteQty", 0) or trade.get("quote_quantity", 0))
                            commission = self._safe_decimal(trade.get("commission", 0))
                            commission_asset = trade.get("commissionAsset", "") or trade.get("commission_asset", "")
                            is_maker = trade.get("isMaker", False) or trade.get("is_maker", False)
                            position_side = trade.get("positionSide", "") or trade.get("position_side", "")
                        else:
                            symbol = getattr(trade, "symbol", "")
                            trade_id = getattr(trade, "trade_id", "") or getattr(trade, "id", "")
                            order_id = getattr(trade, "order_id", "")
                            side = getattr(trade, "side", "")
                            price = self._safe_decimal(getattr(trade, "price", 0))
                            quantity = self._safe_decimal(getattr(trade, "quantity", 0))
                            quote_qty = self._safe_decimal(getattr(trade, "quote_quantity", 0))
                            commission = self._safe_decimal(getattr(trade, "commission", 0))
                            commission_asset = getattr(trade, "commission_asset", "")
                            is_maker = getattr(trade, "is_maker", False)
                            position_side = getattr(trade, "position_side", "")

                        if not trade_id:
                            continue

                        # 检查成交是否已存在（去重）
                        existing_result = await session.execute(
                            select(XTTradeUpdate).where(
                                XTTradeUpdate.trade_id == str(trade_id),
                                XTTradeUpdate.symbol == symbol
                            ).limit(1)
                        )
                        existing_trade = existing_result.scalar_one_or_none()

                        if existing_trade:
                            logger.debug(f"Trade {trade_id} already exists, skipping")
                            skipped_count += 1
                            continue

                        record = XTTradeUpdate(
                            update_time=update_time,
                            symbol=symbol,
                            order_id=str(order_id),
                            trade_id=str(trade_id),
                            side=side,
                            price=price,
                            quantity=quantity,
                            quote_quantity=quote_qty,
                            commission=commission,
                            commission_asset=commission_asset,
                            is_maker=is_maker,
                            position_side=position_side,
                            raw_data=json.dumps({
                                "source": "pyxt_sync_fixed_lookback",
                                "trade": str(trade),
                                "lookback_hours": 1,
                            }, cls=DecimalEncoder),
                        )
                        session.add(record)
                        saved_count += 1

                    except Exception as e:
                        logger.warning(f"Failed to save trade: {e}")
                        continue

                await session.commit()
                logger.info("Synced trade data from pyxt (fixed lookback)", extra={"saved": saved_count, "skipped": skipped_count})

        except Exception as e:
            logger.error(f"Failed to sync trade data (fixed lookback): {e}")
    
