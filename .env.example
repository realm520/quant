# Tri-Arb Environment Variables
# Copy this file to .env and update values as needed

# Application
APP_NAME=tri-arb
LOG_LEVEL=INFO
ENVIRONMENT=development

# Database
DB_PATH=tri_arb.db
DB_POOL_SIZE=5
DB_TIMEOUT=5.0

# Cache
CACHE_TTL=60
CACHE_MAX_SIZE=1000

# Performance
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT=30

# Monitoring
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30
ENABLE_METRICS=true

# Exchanges (placeholder - not functional in MVP)
